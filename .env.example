# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- HumanStandard detection API ---
HS_API_KEY=
# Adjust if the real base URL or path differs from the guess.
HS_API_BASE=https://api.hsverify.com
HS_DETECT_PATH=/v1/detect
HS_TIMEOUT_S=60
HS_MAX_RETRIES=2
# Seconds to wait between calls. Raise it if you hit rate limits.
HS_RATE_LIMIT_S=0.35

# --- Tier thresholds ---
CLEAN_CEILING=25
SUSPECT_FLOOR=65
# Detector confidence below this routes an asset to human review whatever it scored.
MIN_CONFIDENCE=0.60

# --- Valuation ---
DEFAULT_MULTIPLE=15
# Share of contested revenue folded into the escrow recommendation.
CONTESTED_ESCROW_WEIGHT=0.5
