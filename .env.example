# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- HumanStandard detection API ---------------------------------------
# Key from secure.hsverify.com -> Settings -> API Keys. Shown once.
HS_API_KEY=

# Verified against docs.hsverify.com. Note this is NOT api.hsverify.com,
# which does not resolve.
HS_API_BASE=https://app.jobsbyhumans.com
HS_DETECT_PATH=/api/analyze
HS_STATUS_PATH=/api/jobs/{job_id}/status

# /api/analyze is asynchronous: it returns a job_id and the verdict is
# collected by polling. Cold starts are documented at 20-30s.
HS_POLL_INTERVAL_S=2
HS_POLL_TIMEOUT_S=300

# "full" adds risk_segments and tier_verdicts. tier_verdicts is what this
# tool tiers on, so leave this alone unless you know why you are changing it.
HS_DETAIL=full

HS_TIMEOUT_S=60
HS_MAX_RETRIES=2
# Seconds between calls. Their documented rate limit is 60/min.
HS_RATE_LIMIT_S=1.1

# bearer | x-api-key | api-key | authorization-raw | both
HS_AUTH_STYLE=bearer
# The multipart field name the upload goes in.
HS_FILE_FIELD=file

# HumanStandard's own fixtures: human | ai | suspicious | no_vocal.
# Set this and every call returns a real-shaped response and bills NOTHING --
# useful for building. Responses carry "mock": true, which this tool
# propagates, so the memo will refuse to render. Leave EMPTY for a real audit.
HS_MOCK_SCENARIO=

# --- Spending guardrails -----------------------------------------------
# Hard cap on live analysis calls per run. The hackathon key ships with 200,
# and one credit covers one song scan.
HS_CREDIT_BUDGET=200
# Refuse to upload anything larger than this (a DJ set, a radio show).
HS_MAX_UPLOAD_MB=20

# --- Tier thresholds ----------------------------------------------------
# FALLBACK ONLY. With HS_DETAIL=full the agent tiers on HumanStandard's own
# calibrated operating points (press_safe / human_safe / recall) and these
# are never consulted. They apply only to a response without tier_verdicts.
CLEAN_CEILING=25
SUSPECT_FLOOR=65
# A verdict below this confidence is routed to human review whatever it said.
MIN_CONFIDENCE=0.60

# --- Valuation ----------------------------------------------------------
DEFAULT_MULTIPLE=15
# Share of contested revenue folded into the escrow recommendation.
CONTESTED_ESCROW_WEIGHT=0.5
