# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- HumanStandard detection API ---
HS_API_KEY=
# Adjust if the real base URL or path differs from the guess.
HS_API_BASE=https://api.hsverify.com
HS_DETECT_PATH=/v1/detect
HS_TIMEOUT_S=60
HS_MAX_RETRIES=2
# Seconds to wait between calls. Raise it if you hit rate limits.
HS_RATE_LIMIT_S=0.35

# --- Tier thresholds ---
CLEAN_CEILING=25
SUSPECT_FLOOR=65
# Detector confidence below this routes an asset to human review whatever it scored.
MIN_CONFIDENCE=0.60

# --- Valuation ---
DEFAULT_MULTIPLE=15
# Share of contested revenue folded into the escrow recommendation.
CONTESTED_ESCROW_WEIGHT=0.5

# --- Spending guardrails ---
# Hard cap on live detection calls per run. The hackathon key ships with 200.
HS_CREDIT_BUDGET=200
# Refuse to upload anything larger than this (a DJ set, a radio show).
HS_MAX_UPLOAD_MB=20

# --- API shape ---
# Set these from whatever scripts/probe_api.py discovers, so fixing the
# integration is a config change rather than a code change.
# bearer | x-api-key | api-key | authorization-raw | both
HS_AUTH_STYLE=both
# The multipart field name the upload goes in.
HS_FILE_FIELD=file
