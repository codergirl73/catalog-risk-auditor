# secrets -- never commit
.env
*.key

# cached API responses (may contain full detection payloads)
.cache/

# audio and generated data -- nothing under data/ is ever committed except
# the placeholder that keeps the folder in the tree. Audio is large and
# redistributing it is not ours to do; the CSVs are generated.
data/*
!data/.gitkeep

# outputs
out/
!out/.gitkeep
# The evidence of a real API call is a submission artefact, and carries no
# credential -- the request record stores which auth style was used, not the
# key. Verified by CI.
!out/api_evidence.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# os
.DS_Store
Thumbs.db
